# Add this as a Replit Secret, never directly in source code.
OPENAI_API_KEY=your_api_key_here

# Optional. The default supports text, image input, Responses, and structured output.
OPENAI_MODEL=gpt-5.4-mini

# Week 4 evaluation tracing and experiment comparison.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=paperworkpilot-week4-eval
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional. Keep the judge inexpensive; calibrate it against human ratings first.
OPENAI_JUDGE_MODEL=gpt-5.4-mini

# Replit provides PORT automatically.
PORT=3000
