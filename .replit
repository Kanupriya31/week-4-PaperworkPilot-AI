run = "python -m uvicorn backend.app:app --host 0.0.0.0 --port 3000"
entrypoint = "backend/app.py"
modules = ["python-3.10"]

[deployment]
build = ["sh", "-c", "pip install --no-cache-dir -r requirements.txt"]
run = ["sh", "-c", "python -m uvicorn backend.app:app --host 0.0.0.0 --port ${PORT:-3000}"]
deploymentTarget = "cloudrun"

[gitHubImport]
requiredFiles = [".replit", "replit.nix", "requirements.txt"]

[[ports]]
localPort = 3000
externalPort = 80

[nix]
channel = "stable-25_05"
packages = ["libxcrypt"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m uvicorn backend.app:app --host 0.0.0.0 --port 3000"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "webview"
